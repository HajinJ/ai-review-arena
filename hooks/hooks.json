{
  "description": "AI Review Arena - Multi-AI automated code review hook",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/arena-runtime.py hook-post-tool-use --config ${CLAUDE_PLUGIN_ROOT}/config/default-config.json",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/review-gate.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
