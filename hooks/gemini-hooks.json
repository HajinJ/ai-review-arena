{
  "hooks": {
    "AfterTool": [
      {
        "matcher": "write_file|replace_in_file|patch",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=$PLUGIN_DIR python3 -m arena_runtime.orchestrator hook-post-tool-use --config $PLUGIN_DIR/config/default-config.json",
            "timeout": 300000
          }
        ]
      }
    ]
  }
}
